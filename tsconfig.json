{
  "compilerOptions": {
    "target": "ES2017", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2017", "DOM"], "strict": true, "noEmit": true,
    "resolveJsonModule": true, "esModuleInterop": true, "skipLibCheck": true,
    "types": ["vite/client", "node"], "isolatedModules": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts", "tests/**/*.ts", "playwright.config.ts"]
}
